<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.LoginController">
    <children>
      <Label text="Username" />
      <TextField fx:id="txt_username" promptText="Enter your username" text="ccollin" />
      <Label onMouseClicked="#btnLoginClicked" text="Password" />
      <PasswordField fx:id="txt_password" onMouseClicked="#btnLoginClicked" text="7snailBrook&amp;" />
      <Button mnemonicParsing="false" onMouseClicked="#btnLoginClicked" text="Login" />
      <Label fx:id="lbl_error" onMouseClicked="#btnLoginClicked" prefHeight="17.0" prefWidth="45.0" />
       <!-- <Button fx:id="loginButton" onAction="#switchToPrimary" text="Sign in" /> -->
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <stylesheets>
      <URL value="@styles.css" />
   </stylesheets>
</VBox>
